# Scratch design source (already archived under engineering/phase2/evidence/)
/docs/temp/

# Playwright's own runtime output (regenerated by every local/E2E-runner
# invocation, e.g. tests/e2e/test-results/.last-run.json) -- previously
# tracked, which meant every test run drifted a committed file and had to be
# restored via `git checkout --` afterward (RE-QA-F-2T-RUNNER-FLAKY /
# MONGLE-W7-5-BOARD-ROOM-RACE-AND-AUTH-HARDENING-001). A runtime artifact,
# never a source-of-truth file.
tests/e2e/test-results/

# Per-invocation E2E runner logs (HARDENING-QA-F-002 /
# MONGLE-W7-5-HARDENING-QA-FAIL-REMEDIATION-001) -- previously written to
# /tmp, outside the worktree, which the repository-boundary policy
# prohibits. Now an ignored, in-worktree, timestamped-per-run directory
# instead of a fixed path.
tests/e2e/.runtime/
