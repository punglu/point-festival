# === MC Point Festival — Production Environment ===
# NAS에서 이 파일을 .env로 복사하고 실제 값을 채우세요.
# cp .env.production.template .env

# Database
POSTGRES_USER=mc_admin
POSTGRES_PASSWORD=<강력한_비밀번호>
POSTGRES_DB=mc_festival
DATABASE_URL=postgresql+asyncpg://mc_admin:<같은_비밀번호>@db:5432/mc_festival

# JWT (각각 openssl rand -hex 32 로 생성)
JWT_SECRET=<랜덤값_64자>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_SECRET=<다른_랜덤값_64자>
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment — production 시 Swagger 비활성화
ENVIRONMENT=production
