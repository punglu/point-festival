{
  "rules": {
    "mc_players": {
      "$pId": {
        ".read": true,
        ".write": false,
        "statusMsg": {
          ".write": true
        }
      }
    },
    "mc_mission_data": {
      ".read": true,
      "$pId": {
        "$date": {
          "missions": {
            "$mId": {
              "status": {
                ".write": true
              },
              "approvalRequestedAt": {
                ".write": true
              },
              "proposedBy": {
                ".write": true
              },
              "proposalReason": {
                ".write": true
              },
              "proposedAt": {
                ".write": true
              }
            }
          }
        }
      }
    },
    "mc_feedbacks": {
      ".read": true,
      "$pId": {
        "$date": {
          ".write": true
        }
      }
    },
    "mc_deductions": {
      ".read": true,
      ".write": false
    },
    "mc_cheer_msgs": {
      ".read": true,
      ".write": false
    },
    "mc_config": {
      ".read": true,
      ".write": false
    },
    "mc_login_logs": {
      ".read": false,
      ".write": true
    },
    "mc_daily_points": {
      ".read": true,
      ".write": false
    },
    "mc_notifications": {
      ".read": true,
      ".write": true
    }
  }
}
